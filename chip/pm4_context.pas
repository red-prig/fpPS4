unit pm4_context;

{$mode ObjFPC}{$H+}
{$CALLING SysV_ABI_CDecl}

interface

uses
 pm4defs,
 si_ci_vi_merged_offset,
 si_ci_vi_merged_groups;

type
 p_shader_draw_params=^t_shader_draw_params;
 t_shader_draw_params=packed record
  op          :WORD; //IT_DRAW_*
  baseVtxReg  :WORD; //BuiltIn.BaseVertex
  startInstReg:WORD; //BuiltIn.BaseInstance
  drawIndexReg:WORD; //BuiltIn.DrawIndex
 end;

 p_amd_context=^t_amd_context;
 t_amd_context=object
  //
  SG_REG:TSH_REG_GFX_GROUP;     // 0x2C00
  SC_REG:TSH_REG_COMPUTE_GROUP; // 0x2E00
  CX_REG:TCONTEXT_REG_GROUP;    // 0xA000
  UC_REG:TUSERCONFIG_REG_SHORT; // 0xC000
  //
  ASC_COMPUTE:array[0..63] of TSH_REG_COMPUTE_GROUP;
  //
  BASE_ADDR_DISPLAY_LIST     :QWORD;
  BASE_ADDR_DRAW_INDIRECT    :QWORD;
  BASE_ADDR_LOAD_REG         :QWORD;
  BASE_ADDR_INDIRECT_DATA    :QWORD;
  //
  PixelPipeStatControl:TPixelPipeStatControl;
  //
  ShaderDrawParams:t_shader_draw_params;
  //
  property  BASE_ADDR_DISPATCH_INDIRECT:QWORD read BASE_ADDR_DRAW_INDIRECT;
  //
  procedure DrawIndirect(op,baseVtxLoc,startInstLoc,drawIndexLoc:WORD);
  //
  function  set_reg(i:word;data:DWORD):Boolean;
  function  set_sh_reg(i:word;data:DWORD):Boolean;
  function  set_asc_reg(c_id:Byte;i:word;data:DWORD):Boolean;
  function  set_ctx_reg(i:word;data:DWORD):Boolean;
  function  get_reg(i:word):DWORD;
  procedure clear_state;
 end;

implementation

function convert_loc(i:Word):Word; inline;
begin
 Result:=SH_REG_BASE+i;
 case Result of
  mmSPI_SHADER_USER_DATA_VS_0..
  mmSPI_SHADER_USER_DATA_VS_15,
  mmSPI_SHADER_USER_DATA_ES_0..
  mmSPI_SHADER_USER_DATA_ES_15:;
  else
   Result:=0;
 end;
end;

procedure t_amd_context.DrawIndirect(op,baseVtxLoc,startInstLoc,drawIndexLoc:WORD);
begin
 ShaderDrawParams.op          :=op;
 ShaderDrawParams.baseVtxReg  :=convert_loc(baseVtxLoc);
 ShaderDrawParams.startInstReg:=convert_loc(startInstLoc);
 ShaderDrawParams.drawIndexReg:=convert_loc(drawIndexLoc);
end;

function t_amd_context.set_reg(i:word;data:DWORD):Boolean;
begin
 Result:=True;
 case i of
  $2C00..$2D8C:PDWORD(@SG_REG)[i-$2C00]:=data;
  $2E00..$2E7F:PDWORD(@SC_REG)[i-$2E00]:=data;
  $A000..$A38F:PDWORD(@CX_REG)[i-$A000]:=data;
  $C079:PDWORD(@UC_REG.CP_COHER_BASE_HI  )^:=data;
  $C07C:PDWORD(@UC_REG.CP_COHER_CNTL     )^:=data;
  $C07D:PDWORD(@UC_REG.CP_COHER_SIZE     )^:=data;
  $C07E:PDWORD(@UC_REG.CP_COHER_BASE     )^:=data;
  $C08C:PDWORD(@UC_REG.CP_COHER_SIZE_HI  )^:=data;
  $C200:PDWORD(@UC_REG.GRBM_GFX_INDEX    )^:=data;
  $C240:PDWORD(@UC_REG.VGT_ESGS_RING_SIZE)^:=data;
  $C241:PDWORD(@UC_REG.VGT_GSVS_RING_SIZE)^:=data;
  $C242:PDWORD(@UC_REG.VGT_PRIMITIVE_TYPE)^:=data;
  $C243:PDWORD(@UC_REG.VGT_INDEX_TYPE    )^:=data;
  $C24C:PDWORD(@UC_REG.VGT_NUM_INDICES   )^:=data;
  $C24D:PDWORD(@UC_REG.VGT_NUM_INSTANCES )^:=data;
  $C258:PDWORD(@CX_REG.IA_MULTI_VGT_PARAM)^:=data;
  else
   Result:=False;
 end;
end;

function t_amd_context.set_sh_reg(i:word;data:DWORD):Boolean;
begin
 Result:=True;
 case i of
  $000..$18C:PDWORD(@SG_REG)[i]:=data;
  $200..$27F:PDWORD(@SC_REG)[i-$200]:=data;
  else
   Result:=False;
 end;
end;

function t_amd_context.set_asc_reg(c_id:Byte;i:word;data:DWORD):Boolean;
begin
 Result:=True;
 case i of
  $200..$27F:PDWORD(@ASC_COMPUTE[c_id])[i-$200]:=data;
  else
   Result:=False;
 end;
end;

function t_amd_context.set_ctx_reg(i:word;data:DWORD):Boolean;
begin
 Result:=True;
 if (i<=$38F) then
 begin
  PDWORD(@CX_REG)[i]:=data;
 end else
  Result:=False;
end;

function t_amd_context.get_reg(i:word):DWORD;
begin
 case i of
  $2C00..$2D8C:Result:=PDWORD(@SG_REG)[i-$2C00];
  $2E00..$2E7F:Result:=PDWORD(@SC_REG)[i-$2E00];
  $A000..$A38F:Result:=PDWORD(@CX_REG)[i-$A000];
  $C079:Result:=PDWORD(@UC_REG.CP_COHER_BASE_HI  )^;
  $C07C:Result:=PDWORD(@UC_REG.CP_COHER_CNTL     )^;
  $C07D:Result:=PDWORD(@UC_REG.CP_COHER_SIZE     )^;
  $C07E:Result:=PDWORD(@UC_REG.CP_COHER_BASE     )^;
  $C08C:Result:=PDWORD(@UC_REG.CP_COHER_SIZE_HI  )^;
  $C200:Result:=PDWORD(@UC_REG.GRBM_GFX_INDEX    )^;
  $C240:Result:=PDWORD(@UC_REG.VGT_ESGS_RING_SIZE)^;
  $C241:Result:=PDWORD(@UC_REG.VGT_GSVS_RING_SIZE)^;
  $C242:Result:=PDWORD(@UC_REG.VGT_PRIMITIVE_TYPE)^;
  $C243:Result:=PDWORD(@UC_REG.VGT_INDEX_TYPE    )^;
  $C24C:Result:=PDWORD(@UC_REG.VGT_NUM_INDICES   )^;
  $C24D:Result:=PDWORD(@UC_REG.VGT_NUM_INSTANCES )^;
  $C258:Result:=PDWORD(@CX_REG.IA_MULTI_VGT_PARAM)^;
  else
        Result:=0;
 end;
end;

